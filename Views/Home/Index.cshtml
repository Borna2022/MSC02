@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">welcome to my web site</h1>
    @* این عنوان فقط برای نمایش در صفحه است *@
    @* <h1 class="display-4">سوال لول 2 یی نپرس</h1> *@

    <p>
        Learn about
        <a href="https://learn.microsoft.com/aspnet/core"></a>.
    </p>
</div>

<h2>دمای فعلی:</h2>

<p id="temperature">در حال دریافت...</p>

<script>

    // این تابع دما را از آدرس مربوط به دما دریافت می‌کند
    async function getTemperature() {

        // اینجا یک درخواست برای گرفتن دمای فعلی ارسال می‌شود
        const response = await fetch('/api/temperature');

        // پاسخ دریافتی از حالت غیرقابل استفاده به مقدار قابل استفاده تبدیل می‌شود
        const data = await response.json();

        // مقدار دما در صفحه قرار می‌گیرد
        document.getElementById('temperature').textContent = data;
    }

    // هنگام باز شدن صفحه یک بار دما را دریافت کن
    getTemperature();

    // هر یک ثانیه دوباره دما را دریافت کن
    setInterval(getTemperature, 5000);

</script>
